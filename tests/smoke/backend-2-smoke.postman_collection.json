{
  "info": {
    "_postman_id": "be2-smoke-2026-04-17",
    "name": "TCSS 460 Backend 2 — Smoke Tests",
    "description": "End-to-end smoke tests for backend-2 covering dev-login, public GETs, authed writes, ownership, and admin override. Run top-to-bottom — later requests depend on tokens and message IDs set by earlier ones.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 — Setup (login)",
      "item": [
        {
          "name": "dev-login as user (alice)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns token', () => pm.expect(body.token).to.be.a('string'));",
                  "pm.environment.set('userToken', body.token);",
                  "const payload = JSON.parse(atob(body.token.split('.')[1]));",
                  "pm.environment.set('userSub', String(payload.sub));",
                  "pm.test('role is user', () => pm.expect(payload.role).to.eql('user'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{userUsername}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/dev-login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "dev-login"]
            }
          }
        },
        {
          "name": "dev-login as other user (mallory)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.environment.set('otherToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{otherUsername}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/dev-login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "dev-login"]
            }
          }
        },
        {
          "name": "dev-login as admin (seeded)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.environment.set('adminToken', body.token);",
                  "const payload = JSON.parse(atob(body.token.split('.')[1]));",
                  "pm.test('role is admin (seeded)', () => pm.expect(payload.role).to.eql('admin'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/dev-login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "dev-login"]
            }
          }
        },
        {
          "name": "dev-login missing username → 400",
