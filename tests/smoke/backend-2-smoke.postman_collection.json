    {
      "name": "1 — Public GETs",
      "item": [
        {
          "name": "GET /v2/messages (public, paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has data array', () => pm.expect(body.data).to.be.an('array'));",
                  "pm.test('has pagination', () => pm.expect(body.pagination).to.have.keys(['page','limit','total','totalPages']));",
                  "if (body.data.length > 0) pm.environment.set('anyMsgId', String(body.data[0].id));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v2/messages?limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "messages"],
              "query": [{ "key": "limit", "value": "5" }]
            }
          }
        },
        {
          "name": "GET /v1/messages (public, paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('has data array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/messages?limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "messages"],
              "query": [{ "key": "limit", "value": "5" }]
            }
          }
        },
        {
          "name": "GET /v2/messages/:id — single (public, id captured from list)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const msg = pm.response.json().data;",
                  "pm.test('returns the requested id', () => pm.expect(String(msg.id)).to.eql(pm.environment.get('anyMsgId')));",
                  "pm.test('includes author', () => pm.expect(msg.authorUsername || (msg.author && msg.author.username)).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v2/messages/{{anyMsgId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "messages", "{{anyMsgId}}"]
            }
          }
        },
